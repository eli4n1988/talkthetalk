# Optional. The app always runs with the local Hebrew dialogue engine.
# For interactive replies + the most natural Israeli Hebrew voice, set Gemini first.
# Create .env.local in the project root (never commit it) and fill the keys below.

# Preferred: Gemini 3.8 Flash (chat) + Gemini TTS (Hebrew voices Charon/Kore/Puck/Aoede)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fallback chat + gpt-4o-mini-tts (Hebrew works, voices are English-optimized)
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fallback chat only (Claude has no TTS — voice still uses Gemini or OpenAI)
# Get a key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides: gemini | openai | claude
# TALKTHETALK_CHAT_PROVIDER=gemini
# TALKTHETALK_TTS_PROVIDER=gemini
